# Safe local defaults. Copy to ignored .env and never commit secrets.
CHORUS_ENVIRONMENT=development
CHORUS_NAMESPACE=LOCAL_DEVELOPER
CHORUS_AWS_REGION=us-east-1
CHORUS_LOG_LEVEL=INFO
CHORUS_POLICY_VERSION=policy/v1
CHORUS_PUBLIC_BASE_URL=http://localhost:5173

CHORUS_CORE_TABLE=chorus-core-development
CHORUS_SHAREABLE_TABLE=chorus-shareable-development
CHORUS_AUDIT_TABLE=chorus-audit-development
CHORUS_PRIVATE_EVIDENCE_BUCKET=chorus-private-evidence-development
CHORUS_EXPORT_EVIDENCE_BUCKET=chorus-export-evidence-development
# The exact KMS key ARN each evidence bucket is encrypted under (from CDK outputs). Blank for
# local development, where the in-memory object store is used and no bucket policy is evaluated;
# a deployed compiler refuses to construct without both (deployment contract SS 9).
CHORUS_PRIVATE_EVIDENCE_KEY_ARN=
CHORUS_EXPORT_EVIDENCE_KEY_ARN=
# A local DynamoDB endpoint. Leave blank (unset) to reach the real service; a deployed API
# refuses to construct when this is set at all.
CHORUS_DYNAMODB_ENDPOINT=http://localhost:8000
CHORUS_LOCAL_DATA_DIR=.local

CHORUS_AGENT_MODE=fake
CHORUS_MONITOR_RUNTIME_ARN=
CHORUS_INVESTIGATOR_RUNTIME_ARN=
CHORUS_ACTION_RUNTIME_ARN=
CHORUS_MONITOR_MODEL_PROFILE_ARN=
CHORUS_INVESTIGATOR_MODEL_PROFILE_ARN=
CHORUS_ACTION_MODEL_PROFILE_ARN=
CHORUS_AGENT_TIMEOUT_SECONDS=30

CHORUS_SENDER_FUNCTION_ARN=
CHORUS_COMPILER_FUNCTION_ARN=
CHORUS_WATCHER_FUNCTION_ARN=
CHORUS_WORKER_FUNCTION_ARN=
CHORUS_SCHEDULER_GROUP=chorus-development
# The short (<=8 char) environment token inside the frozen EventBridge Scheduler name.
CHORUS_SCHEDULER_ENVIRONMENT=dev
CHORUS_SCHEDULER_ROLE_ARN=
CHORUS_SES_CONFIGURATION_SET=chorus-development
# Opaque stable identifier for the verified sending identity; never the From address.
CHORUS_SES_FROM_IDENTITY_ID=chorus-demo-sender
CHORUS_DESTINATION_ID=property_manager:demo
CHORUS_DESTINATION_DISPLAY_LABEL=Property Management
CHORUS_DESTINATION_REGISTRY_VERSION=1
CHORUS_DESTINATION_ROUTING_TOKEN=00000000-0000-0000-0000-000000000000
# Secrets Manager identities (ARNs only -- the values are created out of band, never here).
# sender-only: verified destination record. API-only: the demo bearer-token hash, and the
# pagination cursor-signing HMAC key (a separate secret, unrelated rotation and blast radius).
CHORUS_DESTINATION_REGISTRY_SECRET_ARN=
CHORUS_DEMO_ACCESS_SECRET_ARN=
CHORUS_CURSOR_SIGNING_SECRET_ARN=
CHORUS_DEMO_CLOCK_ENABLED=true

CHORUS_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=chorus-api

